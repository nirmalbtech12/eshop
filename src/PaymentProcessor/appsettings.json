{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "EventBus": "amqp://localhost",
    "paymentdb": "Host=localhost;Database=paymentdb;Username=postgres"
  },
  "EventBus": {
    "SubscriptionClientName": "PaymentProcessor"
  },
  "PaymentOptions": {
    "PaymentSucceeded": true,
    "MaxAttempts": 3,
    "AttemptTimeout": "00:00:02",
    "InitialBackoff": "00:00:00.250",
    "MaxBackoff": "00:00:02",
    "TimeoutCount": 0,
    "TimeoutAfterCharge": false
  }
}
